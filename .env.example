# =============================================================================
# Variables de Entorno para Vercel / Producción / Local
# =============================================================================

# Configuración de Base de Datos MySQL (en Vercel usa tu host cloud: TiDB, PlanetScale, Aiven, Clever Cloud, etc.)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_asistencia
# Habilitar SSL para bases de datos en la nube (TiDB Cloud, Aiven, etc.)
DB_SSL=false

# Configuración de la API Externa de DNI (APISPeru)
DNI_API_BASE_URL=https://dniruc.apisperu.com
DNI_API_TOKEN=tu_token_aqui
DNI_API_TIMEOUT_SECONDS=5.0

# Configuración del Entorno
ENVIRONMENT=production
CORS_ORIGINS=["*"]
