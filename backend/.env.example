# Configuración de Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=db_asistencia

# Configuración de la API Externa de DNI
DNI_API_BASE_URL=https://api.ejemplo.com/dni?numero=
DNI_API_TOKEN=tu_api_token_aqui
DNI_API_TIMEOUT_SECONDS=5.0

# Configuración del Servidor
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://localhost:8080","*"]
